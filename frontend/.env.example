# Data source mode
# integration: call Spring Boot API through Vite proxy
# mock: bypass backend and use local frontend mock data
VITE_DASHBOARD_DATA_SOURCE=integration

# Comma-separated main navigation pages shown in the current presentation build
VITE_VISIBLE_PAGES=overview

# API base URL used in integration mode
VITE_API_BASE_URL=/api

# Dev proxy switch for Vite
VITE_USE_PROXY=true
VITE_DEV_PROXY_TARGET=http://localhost:8080
